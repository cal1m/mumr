{
  "name": "mumr",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-user mixed reality for WebXR headsets: a shared world, authority by touch, a PC hub. No build step, no dependencies.",
  "scripts": {
    "test": "node --test",
    "test:py": "py -3 -m unittest discover -s server/tests -p \"test_*.py\"",
    "counter": "py -3 server/serve.py examples/counter 8766 --http --no-browser",
    "dnd": "py -3 server/serve.py apps/dnd",
    "dnd:pc": "py -3 server/serve.py apps/dnd 8766 --http --no-browser",
    "dnd:sim": "node tools/dnd-sim.js all"
  }
}
